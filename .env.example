# Postgres connection string.
# Local: postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Netlify (use a hosted DB — Neon free tier recommended): postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin login (your_username_here / your_password_here
 if left unset)
ADMIN_USERNAME=your_username_here
ADMIN_PASSWORD=your_password_here
